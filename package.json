{
  "name": "practica2-programacionweb",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicacion Node.js + Express + GraphQL para portal de productos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "e2e:install": "npm --prefix test_e2e install",
    "e2e:open": "npm --prefix test_e2e run cy:open",
    "e2e:run": "npm --prefix test_e2e run cy:run"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "apollo-server-express": "^3.13.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
